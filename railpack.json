{
  "$schema": "https://schema.railpack.com",
  "provider": "python",

  "buildAptPackages": [
    "...",
    "binutils",
    "gdal-bin",
    "libgdal-dev",
    "libgeos-dev"
  ],

  "deploy": {
    "aptPackages": ["...", "gdal-bin", "libgdal-dev", "libgeos-dev"],
    "startCommand": "daphne -b 0.0.0.0 -p ${PORT:-8000} marketlift.asgi:application"
  }
}
