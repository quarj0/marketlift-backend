# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LOG_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=WARNING

# Provider-neutral database configuration.
# These override the legacy POSTGRES_* values used by docker-compose.
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=marketlift
DB_USER=marketlift
DB_PASSWORD=marketlift
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONN_MAX_AGE=60
DB_SSLMODE=

# Docker/local PostgreSQL compatibility
POSTGRES_DB=marketlift
POSTGRES_USER=marketlift
POSTGRES_PASSWORD=marketlift
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_CONN_MAX_AGE=60

# Cache / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2


# Realtime WebSocket transport
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/3
MARKETLIFT_CHANNEL_LAYER_BACKEND=channels_redis.core.RedisChannelLayer
MARKETLIFT_CHANNEL_CAPACITY=1000
MARKETLIFT_CHANNEL_EXPIRY_SECONDS=60
MARKETLIFT_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MARKETLIFT_WEBSOCKET_ACTION_RATE_LIMIT_PER_MINUTE=180

# Browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Browser sessions / production HTTPS controls
SESSION_COOKIE_NAME=marketlift_sessionid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=1209600
SESSION_SAVE_EVERY_REQUEST=false
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_PROXY_SSL_HEADER_ENABLED=false
USE_X_FORWARDED_HOST=false

# Email / public frontend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Marketlift <noreply@marketlift.local>
MARKETLIFT_FRONTEND_URL=http://localhost:3000

# Provider-neutral upload storage. Development uses local files.
MARKETLIFT_STORAGE_BACKEND=uploads.storage.local.LocalStorageBackend
MARKETLIFT_LOCAL_UPLOAD_ROOT=.marketlift-uploads
MARKETLIFT_STRICT_UPLOAD_VALIDATION=true
MARKETLIFT_PROCESS_UPLOADS_ASYNC=false

# Generic bridge to any installed Django-compatible remote storage backend.
# To use it set:
# MARKETLIFT_STORAGE_BACKEND=uploads.storage.django_storage.DjangoStorageBackend
MARKETLIFT_DJANGO_STORAGE_ALIAS=marketlift_media
MARKETLIFT_DJANGO_STORAGE_CLASS=django.core.files.storage.FileSystemStorage
MARKETLIFT_DJANGO_STORAGE_LOCATION=.marketlift-remote
MARKETLIFT_DJANGO_STORAGE_BASE_URL=/media/
MARKETLIFT_DJANGO_STORAGE_OPTIONS_JSON=

# Marketlift service payments only (seller plans + listing promotions).
MARKETLIFT_PAYMENT_PROVIDER=mock
PAYMENT_MOCK_AUTO_APPROVE=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Deployment mode / production hardening
MARKETLIFT_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
MARKETLIFT_TRUST_PROXY_HEADERS=false
SECURE_PROXY_SSL_HEADER_ENABLED=false
MARKETLIFT_GRAPHQL_RATE_LIMIT_PER_MINUTE=120
MARKETLIFT_GRAPHQL_MAX_DEPTH=12
MARKETLIFT_GRAPHQL_MAX_TOKENS=5000
MARKETLIFT_GRAPHQL_MAX_ALIASES=30
MARKETLIFT_DISABLE_GRAPHQL_INTROSPECTION=false
MARKETLIFT_GRAPHQL_IDE_ENABLED=true
DB_CONN_HEALTH_CHECKS=true

MARKETLIFT_ADMIN_FRONTEND_URL=http://localhost:3001
MARKETLIFT_ADMIN_MFA_REQUIRED=false
MARKETLIFT_ADMIN_MFA_TTL_SECONDS=600

# Marketplace search
# Keep clients independent of the engine; this class can later be replaced by an OpenSearch adapter.
MARKETLIFT_SEARCH_BACKEND=marketlift.search.backends.postgres.PostgresListingSearchBackend
MARKETLIFT_SEARCH_RATE_LIMIT_PER_MINUTE=240
MARKETLIFT_SEARCH_MAX_QUERY_LENGTH=160
MARKETLIFT_SEARCH_MAX_PAGE_SIZE=50
MARKETLIFT_SEARCH_MAX_WINDOW=5000
MARKETLIFT_SEARCH_STATEMENT_TIMEOUT_MS=1500

# Geospatial location / provider-neutral geocoding
MARKETLIFT_LOCATION_MAX_RADIUS_KM=200
MARKETLIFT_LOCATION_RATE_LIMIT_PER_MINUTE=30
MARKETLIFT_LOCATION_QUERY_MAX_LENGTH=160
MARKETLIFT_LOCATION_TOKEN_MAX_AGE_SECONDS=86400
# Require frontend location selections to come from a signed resolver result in production.
MARKETLIFT_REQUIRE_RESOLVED_LISTING_LOCATION=false
# Development default. For production, configure a provider that satisfies your traffic/SLA terms.
MARKETLIFT_GEOCODER_BACKEND=marketlift.location.providers.nominatim.NominatimGeocoder
MARKETLIFT_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MARKETLIFT_GEOCODER_TIMEOUT_SECONDS=4
MARKETLIFT_GEOCODER_CACHE_SECONDS=86400
MARKETLIFT_GEOCODER_LANGUAGE=pt-BR,en
MARKETLIFT_GEOCODER_USER_AGENT=Marketlift/0.1 development
