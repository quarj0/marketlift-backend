# Local development works without database/Redis configuration when using the
# repository's default PostGIS (127.0.0.1:5433) and Redis (127.0.0.1:6379).
DJANGO_SECRET_KEY=local-development-only

# Optional frontend overrides for local Next.js apps.
MARKETLIFT_FRONTEND_URL=http://localhost:3001
MARKETLIFT_ADMIN_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3000

# Marketplace commerce / Pagar.me V5. Use sk_test_* while developing.
# Marketlift's own recipient receives the marketplace fee and delivery charges.
MARKETLIFT_COMMERCE_PROVIDER=pagarme
PAGARME_SECRET_KEY=
PAGARME_MARKETPLACE_RECIPIENT_ID=
# Random high-entropy value used in the Pagar.me webhook URL.
PAGARME_WEBHOOK_TOKEN=
PAGARME_BASE_URL=https://api.pagar.me/core/v5
PAGARME_PIX_EXPIRES_SECONDS=1800
PAGARME_STATEMENT_DESCRIPTOR=MARKETLIFT
# 500 basis points = 5% commission.
MARKETLIFT_COMMERCE_FEE_BPS=500
MARKETLIFT_BUYER_PROTECTION_HOURS=48
MARKETLIFT_LOCAL_DELIVERY_FEE_CENTS=0

# Optional SMTP / R2 credentials when testing those integrations locally.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Alternative geocoder for testing / production.
# MARKETLIFT_GEOCODER_BACKEND=marketlift.location.providers.opencage.OpenCageGeocoder
# OPENCAGE_API_KEY=

# Switch providers without changing marketplace/listing business logic:
# MARKETLIFT_GEOCODER_BACKEND=marketlift.location.providers.geoapify.GeoapifyGeocoder
# GEOAPIFY_API_KEY=

# FIPE vehicle catalog (Parallelum / fipe.api.br)
# Keep the token server-side. FIPE_API_KEY and FIPE_TOKEN are accepted aliases.
FIPE_API_TOKEN=
FIPE_API_BASE_URL=https://fipe.parallelum.com.br/api/v2
# Increase only if your FIPE plan supports the request volume.
FIPE_SYNC_MAX_REQUESTS=10000

# Dynamic catalog cache / fallback
DYNAMIC_CATALOG_FIPE_TTL_SECONDS=2592000
DYNAMIC_CATALOG_WIKIDATA_TTL_SECONDS=2592000
DYNAMIC_CATALOG_PROVIDER_COOLDOWN_SECONDS=3600
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql

# Optional Icecat product-sheet enrichment (not needed for Brand -> Model selectors)
# ICECAT_USERNAME=
# ICECAT_PASSWORD=
# ICECAT_API_TOKEN=
# ICECAT_CONTENT_TOKEN=
# ICECAT_LANGUAGE=EN
# ICECAT_JSON_URL=https://live.icecat.biz/api
