DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo

POSTGRES_DB=marketlift
POSTGRES_USER=marketlift
POSTGRES_PASSWORD=marketlift
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Browser session / CSRF cookies
SESSION_COOKIE_NAME=marketlift_sessionid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax

# Service payments (subscriptions/promotions only)
MARKETLIFT_PAYMENT_PROVIDER=mock
PAYMENT_MOCK_AUTO_APPROVE=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Provider-neutral database aliases. These override legacy POSTGRES_* values.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=marketlift
DB_USER=marketlift
DB_PASSWORD=marketlift
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONN_MAX_AGE=60
DB_SSLMODE=

# Provider-neutral upload storage. Keep local for development; later point the
# dotted class at any adapter implementing uploads.storage.base.StorageBackend.
MARKETLIFT_STORAGE_BACKEND=uploads.storage.local.LocalStorageBackend
MARKETLIFT_LOCAL_UPLOAD_ROOT=.marketlift-uploads
