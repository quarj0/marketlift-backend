# Deployment identity
MARKETLIFT_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_ALLOWED_HOSTS=api.marketlift.com.br
DJANGO_TIME_ZONE=America/Sao_Paulo

# Public applications
MARKETLIFT_FRONTEND_URL=https://marketlift.com.br
MARKETLIFT_ADMIN_FRONTEND_URL=https://admin.marketlift.com.br
MARKETLIFT_ADMIN_SESSION_ORIGINS=https://admin.marketlift.com.br
CORS_ALLOWED_ORIGINS=https://marketlift.com.br,https://admin.marketlift.com.br
CSRF_TRUSTED_ORIGINS=https://marketlift.com.br,https://admin.marketlift.com.br
MARKETLIFT_WEBSOCKET_ALLOWED_ORIGINS=https://marketlift.com.br,https://admin.marketlift.com.br

# Provider-backed release gates. Do not enable until certified integrations ship.
MARKETLIFT_PAYMENTS_ENABLED=false
MARKETLIFT_CPF_VERIFICATION_ENABLED=false
MARKETLIFT_IDENTITY_VERIFICATION_PROVIDER=disabled
MARKETLIFT_PAYMENT_PROVIDER=disabled
PAYMENT_MOCK_AUTO_APPROVE=false

# PostgreSQL/PostGIS (replace all placeholders)
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=marketlift
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=replace-me
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

# Shared Redis-compatible services (use TLS endpoints in production)
REDIS_URL=rediss://replace-me/0
CELERY_BROKER_URL=rediss://replace-me/1
CELERY_RESULT_BACKEND=rediss://replace-me/2
CHANNEL_REDIS_URL=rediss://replace-me/3

# Transactional email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-me
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Marketlift <noreply@marketlift.com.br>

# Cloudflare R2 / S3-compatible durable storage (four distinct buckets)
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_ACCOUNT_ID=replace-me
R2_ENDPOINT_URL=https://replace-me.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=marketlift-public
R2_PRIVATE_BUCKET=marketlift-private
R2_EVIDENCE_BUCKET=marketlift-evidence
R2_TEMP_BUCKET=marketlift-temp
R2_PUBLIC_BASE_URL=https://assets.marketlift.com.br

# HTTPS and application security
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_PROXY_SSL_HEADER_ENABLED=true
MARKETLIFT_TRUST_PROXY_HEADERS=true
MARKETLIFT_DISABLE_GRAPHQL_INTROSPECTION=true
MARKETLIFT_GRAPHQL_IDE_ENABLED=false
MARKETLIFT_ADMIN_MFA_REQUIRED=true
MARKETLIFT_REQUIRE_RESOLVED_LISTING_LOCATION=true
MARKETLIFT_GEOCODER_USER_AGENT=Marketlift/1.0 ops@marketlift.com.br

# Set to a contracted geocoding service or a self-hosted endpoint before launch.
MARKETLIFT_NOMINATIM_BASE_URL=https://replace-with-production-geocoder.example

# ---- Market bootstrap only ----
# The first migration uses this to choose the initial default market. After
# migration, country enable/disable/default/provider settings are admin-managed.
MARKETLIFT_MARKET_CODE=BR
MARKETLIFT_ENABLED_MARKETS=BR
MARKETLIFT_PAYMENT_PROVIDER=auto
MARKETLIFT_PAYMENT_METHODS=
MARKETLIFT_IDENTITY_VERIFICATION_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
